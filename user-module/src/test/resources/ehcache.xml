<config xmlns="http://www.ehcache.org/v3">

	<!--
	EHCache 3 does not appear to have an (easy) equivalent for
	  <defaultCache eternal="true" maxElementsInMemory="100" overflowToDisk="false"/>
	There is:
	  https://stackoverflow.com/questions/59263094/ehcache3-defaultcache-configuration-equivalent
	But that has just one answer and no votes.
	-->

	<cache alias="securityPrincipalCache">
		<resources>
			<heap unit="entries">1</heap>
		</resources>
	</cache>

	<cache alias="userCache">
		<resources>
			<heap unit="entries">10</heap>
		</resources>
	</cache>

</config>
